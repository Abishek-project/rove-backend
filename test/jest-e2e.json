{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.jest.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/setup-env.ts"
  ],
  "testTimeout": 60000,
  "globalSetup": "<rootDir>/cleanup.ts",
  "globalTeardown": "<rootDir>/cleanup.ts"
}
