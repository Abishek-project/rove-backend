# ─────────────────────────────────────────────────────────────────────────────
# Rove backend — environment variables.
# Copy to `.env` for local development:  cp .env.example .env
# Every value below is a SAFE LOCAL DEFAULT. The Supabase keys are the well-known
# demo keys printed by `npx supabase start` / `npx supabase status` for the local
# stack only — never use them anywhere else. Real deployments inject secrets via env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Browser origins allowed by CORS (partner dashboard).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=log

# ── Supabase (local stack from `npx supabase start`) ──
SUPABASE_URL=http://127.0.0.1:54321
# Service role key: SERVER-SIDE ONLY. Never put this in a client app.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Public anon key (what clients use for sign-in). The backend uses it only in seed/e2e tests.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# HS256 fallback for legacy symmetric tokens (asymmetric tokens are verified via JWKS).
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Expected `iss` claim; leave empty to skip the issuer check.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Optional: host clients use to reach Supabase Storage URLs (e.g. http://10.0.2.2:54321 for
# the Android emulator). Defaults to SUPABASE_URL.
STORAGE_PUBLIC_URL=
SIGNED_URL_TTL_SECONDS=600

# ── Database (backend connects as postgres; RLS is bypassed and enforced in code) ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MAX=10

# ── Payments ── only `mock` exists in v1
PAYMENT_PROVIDER=mock

# ── Rate limiting (per user, per window) ──
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_WRITE_LIMIT=60

# Run the hold / partner-response expiry job every minute.
ENABLE_CRON=true

# ── Seed (npm run seed) — shared password for all seeded local test accounts ──
SEED_USER_PASSWORD=RoveDev!2026

# ── Google OAuth for the local Supabase Auth (read by supabase/config.toml) ──
# See README → "Enabling Google sign-in". Leave empty to use dev email login only.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
